QMainWindow, QWidget {
    background-color: #f4f7fb;
    color: #0f172a;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Arial, sans-serif;
    font-size: 13px;
}

QLabel#titleLabel {
    font-size: 20px;
    font-weight: bold;
    color: #0f172a;
    background-color: transparent;
}

QLabel#fileLabel {
    color: #475569;
    font-size: 13px;
    padding: 0 6px;
    background-color: transparent;
}

QFrame#controlCard {
    background-color: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 10px;
}

QFrame#controlCard QLabel {
    background-color: transparent;
    color: #334155;
    font-weight: 600;
}

QPushButton {
    background-color: #2563eb;
    color: #ffffff;
    border: 1px solid #2563eb;
    border-radius: 7px;
    padding: 8px 16px;
    font-size: 13px;
    font-weight: 600;
}

QPushButton:hover {
    background-color: #1d4ed8;
    border-color: #1d4ed8;
}

QPushButton:pressed {
    background-color: #1e40af;
    border-color: #1e40af;
}

QPushButton#updateButton {
    background-color: #0f766e;
    border: 1px solid #0f766e;
    color: #ffffff;
}

QPushButton#updateButton:hover {
    background-color: #115e59;
    border-color: #115e59;
}

QPushButton#updateButton:pressed {
    background-color: #134e4a;
    border-color: #134e4a;
}

QPushButton#aboutButton {
    background-color: #ffffff;
    color: #334155;
    border: 1px solid #cbd5e1;
    border-radius: 7px;
    padding: 7px 14px;
}

QPushButton#aboutButton:hover {
    background-color: #f1f5f9;
    border-color: #94a3b8;
    color: #0f172a;
}

QSpinBox {
    background-color: #ffffff;
    color: #0f172a;
    border: 1px solid #cbd5e1;
    border-radius: 7px;
    padding: 6px 10px;
    font-size: 13px;
    font-weight: 600;
}

QSpinBox:focus {
    border: 1px solid #2563eb;
}

QTableWidget {
    background-color: #ffffff;
    alternate-background-color: #f8fafc;
    color: #0f172a;
    border: 1px solid #e2e8f0;
    border-radius: 10px;
    gridline-color: #e2e8f0;
    selection-background-color: #dbeafe;
    selection-color: #1e3a8a;
}

QTableWidget::item {
    padding: 6px 10px;
}

QTableWidget::item:selected {
    background-color: #dbeafe;
    color: #1e3a8a;
}

QHeaderView::section {
    background-color: #1e293b;
    color: #ffffff;
    border: none;
    border-right: 1px solid #334155;
    padding: 10px 8px;
    font-size: 13px;
    font-weight: bold;
}

QHeaderView::section:last {
    border-right: none;
}

QTableCornerButton::section {
    background-color: #1e293b;
    border: none;
}
